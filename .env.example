# Database Configuration
MYSQL_ROOT_PASSWORD=<your_mysql_root_password>
MYSQL_DATABASE=test_platform
MYSQL_USER=root
MYSQL_PASSWORD=<your_mysql_password>
DATABASE_URL_DEV=mysql+aiomysql://root:root@127.0.0.1:3306/test_platform
REDIS_URL_DEV=redis://127.0.0.1:6379/0

# Security
SECRET=<your_jwt_secret_32_plus_chars>
# SERVER_BASE_URL=http://your-domain.com  # 本地默认 http://localhost，无需配置

# SMTP Email Configuration
SMTP_USERNAME=<your_smtp_username>
SMTP_PASSWORD=<your_smtp_password>

# JIRA Integration
JIRA_USER=<your_jira_email>
JIRA_API_TOKEN=<your_jira_api_token>

# LLM Configuration
LLM_API_KEY=<your_llm_api_key>
