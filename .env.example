# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=test_platform
MYSQL_USER=test_user
MYSQL_PASSWORD=test_password
# Production (Docker): uses mysql/redis service names
# Development (Local): uses 127.0.0.1
# Code auto-selects: PROD if set, otherwise DEV
DATABASE_URL_PROD=mysql+aiomysql://root:root@mysql:3306/test_platform
REDIS_URL_PROD=redis://redis:6379/0
DATABASE_URL_DEV=mysql+aiomysql://root:root@127.0.0.1:3306/test_platform
REDIS_URL_DEV=redis://127.0.0.1:6379/0

# Security
SECRET=replace-with-a-32-plus-character-random-string
ADMIN_DEFAULT_EMAIL=admin@qq.com
ADMIN_DEFAULT_PASSWORD=admin1234
FORCE_RESET_ADMIN_PASSWORD=false

# SMTP Email Configuration
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your-email@qq.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=your-email@qq.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Frontend Base URLs
VERIFY_BASE_URL=http://localhost:9528/#/verify-email
RESET_BASE_URL=http://localhost:9528/#/reset-password

# Other
KB_PDF_PATH=app/Gino_product_specification.pdf
