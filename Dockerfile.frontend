FROM node:16-alpine AS build
WORKDIR /app
COPY vue-admin-template/package.json ./vue-admin-template/
RUN cd vue-admin-template && npm install
COPY vue-admin-template ./vue-admin-template
RUN cd vue-admin-template && npm run build:prod

FROM python:3.11-slim
WORKDIR /app
COPY --from=build /app/vue-admin-template/dist ./dist
EXPOSE 8080
CMD ["python", "-m", "http.server", "8080", "--directory", "dist"]
